# Plantilla de backend/.env PARA EL SERVIDOR. Copiar a backend/.env en el VPS y completar.
# NUNCA subir el archivo completado a GitHub.

# ---- Django ----
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=apigps.jalmeco.pro
API_DOMAIN=apigps.jalmeco.pro
# Ruta del admin de Django (respaldo), difícil de adivinar. Termina en /
ADMIN_URL=gestion-CAMBIAR/

# Panel en Hostinger: el único origen que puede llamar a la API
CORS_ALLOWED_ORIGINS=https://ubicacionesgps.jalmeco.pro
CSRF_TRUSTED_ORIGINS=https://apigps.jalmeco.pro
PANEL_URL=https://ubicacionesgps.jalmeco.pro

# Sesiones: el access dura 60 min; el refresh, 30 días (la app no pide PIN cada día)
JWT_ACCESS_MIN=60
JWT_REFRESH_DIAS=30

# ---- Base de datos (solo dentro de Docker; no se publica a internet) ----
# Contraseña: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_NAME=jalmeco
DB_USER=jalmeco
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ---- Odoo ----
ODOO_URL=https://jalmeco.odoo.com
ODOO_DB=appexbo-jalmeco-teknoliff-main-41805985
ODOO_USUARIO=
ODOO_API_KEY=

# ---- Correo de alertas (Gmail: contraseña de aplicación) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Respaldos (opcional): copiar cada respaldo al NAS por rsync/SSH ----
NAS_DESTINO=
