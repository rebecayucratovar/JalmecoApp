# Copiar a .env y completar. NUNCA subir .env al repositorio.

# Django
# En producción: una clave larga y al azar (50+ caracteres). Generarla con:
#   docker compose exec backend python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-secreta
DEBUG=True
# Para probar la app: 10.0.2.2 = emulador; agrega la IPv4 de tu PC (ipconfig) para un celular real
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Base de datos PostgreSQL + PostGIS
DB_NAME=jalmeco
DB_USER=jalmeco
DB_PASSWORD=jalmeco
# "db" dentro de Docker Compose; "localhost" si corres Django fuera de Docker
DB_HOST=db
DB_PORT=5432

# Odoo (XML-RPC). La clave API se crea en Odoo: Mi perfil → Seguridad de la cuenta → Nueva clave API
ODOO_URL=https://jalmeco.odoo.com
ODOO_DB=
ODOO_USUARIO=
ODOO_API_KEY=

# Correo para las alertas al administrador. Vacío = solo se muestran en el log del worker.
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (16 letras).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Enlace al panel web en los correos (opcional), p. ej. https://ubicacionesgps.jalmeco.pro
PANEL_URL=

# ---- Solo producción (ver docs/despliegue.md y deploy/env.produccion.example) ----
# Dominio del panel que puede llamar a la API (CORS) y orígenes de confianza para /admin
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Ruta del admin de Django (en producción, una difícil de adivinar)
ADMIN_URL=admin/
