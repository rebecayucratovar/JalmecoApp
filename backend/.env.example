# Copiar a .env y completar. NUNCA subir .env al repositorio.

# Django
SECRET_KEY=cambia-esta-clave-secreta
DEBUG=True
# Para probar la app: 10.0.2.2 = emulador; agrega la IPv4 de tu PC (ipconfig) para un celular real
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Base de datos PostgreSQL + PostGIS
DB_NAME=jalmeco
DB_USER=jalmeco
DB_PASSWORD=jalmeco
# "db" dentro de Docker Compose; "localhost" si corres Django fuera de Docker
DB_HOST=db
DB_PORT=5432

# Odoo (XML-RPC). La clave API se crea en Odoo: Mi perfil → Seguridad de la cuenta → Nueva clave API
ODOO_URL=https://jalmeco.odoo.com
ODOO_DB=
ODOO_USUARIO=
ODOO_API_KEY=

# Correo para las alertas al administrador. Vacío = solo se muestran en el log del worker.
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (16 letras).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Enlace al panel web en los correos (opcional), p. ej. https://gps.jalmeco.com
PANEL_URL=
